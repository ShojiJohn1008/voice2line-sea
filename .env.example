# See docs/token-setup.md for how to get each value.

PORT=3000

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Local development: put the JSON file path here.
GOOGLE_SHEETS_CREDENTIALS_PATH=./google-service-account.json

# Production: prefer one of these instead of a file path.
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_CREDENTIALS_BASE64=

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=reflections!A:I

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-10-21

# LIFF app ID used by /liff/index.html.
LIFF_ID=

# Optional. Required only for speech recognition in the LIFF screen.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
AZURE_SPEECH_ENDPOINT=

# "next" follow-up bot.
# Cron for the weekly check-in push (default: Monday 18:00 JST). Set "off" to disable.
FOLLOWUP_CRON=0 18 * * 1
FOLLOWUP_TIMEZONE=Asia/Tokyo
# Only open "next" items from the last N days are asked about.
FOLLOWUP_LOOKBACK_DAYS=14
# Required to use POST /api/followup/run (sent as x-followup-secret header).
FOLLOWUP_SECRET=
